<Project Sdk="Microsoft.NET.Sdk">

  <!-- The extracted engine's OWN enforcement guard. Note what it does NOT reference: no tests/Harness, no
       ParityGuard, no Rulebook machinery. Plain xUnit that shells out to the built engine (ADR 0015's
       process boundary), proving document enforceability travels without the test-harness pillar. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- The engine lives next door; stamp its location so the guard can find it without a project reference. -->
  <ItemGroup>
    <AssemblyMetadata Include="EngineDir" Value="$(MSBuildProjectDirectory)/../Engine" />
  </ItemGroup>

</Project>
