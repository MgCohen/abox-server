<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 3: the SAME engine as tools/doc-engine, now carrying the packaging that makes it an installable
       CLI. Two additions over the in-repo csproj: PackAsTool (this ships as `docengine`) and the catalog
       shipped as tool content, so an installed copy finds its own catalog with no repo checkout nearby. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ABox.DocEngine</RootNamespace>
    <AssemblyName>docengine</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docengine</ToolCommandName>
    <PackageId>ABox.DocEngine.Tool</PackageId>
    <Version>0.1.0</Version>
    <PackageOutputPath>$(PackOutDir)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- The catalog IS the tool's data. Copy it next to the executable so it packs into the tool and an
       installed `docengine` resolves it from its own install dir (AppContext.BaseDirectory) when no repo
       catalog is on the walk-up path. "The engine names no kind" — the vocabulary rides along as content. -->
  <ItemGroup>
    <Content Include="_schema/**/*.yaml;kinds/**/*.yaml;blocks/**/*.yaml;doctypes/**/*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
