<Project Sdk="Microsoft.NET.Sdk">

  <!-- The extracted harness ENGINE. Same library shape as tests/Harness (a [Rule] + ParityGuard library the
       suites reference), renamed off the ABox prefix — the one token the extraction changes. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Kit.Tests.Harness</RootNamespace>
    <AssemblyName>Kit.Tests.Harness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
